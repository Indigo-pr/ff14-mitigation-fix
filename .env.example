# 開発用の環境変数の雛形。これをコピーして .env を作り、値を書き込む。
#
#   Copy-Item .env.example .env
#   （.env は Git 追跡外。Claude Code からも読み取り禁止に設定済み）
#
# 使い方:
#   . .\tools\load-env.ps1
#   python tools/fflogs_unmitigated.py 9
#
# このファイル自体には値を書かないこと。コミットされます。

# ------------------------------------------------------------------
# FFLogs V2 API クライアント
#   https://www.fflogs.com/api/clients/ で作成する
#   Public Client はチェックしない（チェックすると client_secret が出ない）
#
#   ※ Apps Script 本体（mitigation_fix.gs）はこの .env を使いません。
#      あちらはスプレッドシートのスクリプトプロパティに保存します。
#      ここは tools/fflogs_unmitigated.py など調査用スクリプト向けです。
# ------------------------------------------------------------------
FFLOGS_CLIENT_ID=
FFLOGS_CLIENT_SECRET=

# ------------------------------------------------------------------
# 調査対象のレポートコード（任意。省略時はスクリプト内の既定値）
#   限定公開ログのコードはコミットしないこと（investigations/README.md 参照）
# ------------------------------------------------------------------
FFLOGS_REPORT=
